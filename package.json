{
  "name": "diamante-business-gestao-da-jornada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local -c wrangler.backoffice-local.jsonc && wrangler d1 migrations apply DB --local",
    "db:producao:listar": "wrangler d1 migrations list DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "dev:dados": "esbuild tests/apoio/preparar-local.ts --bundle --platform=node --format=esm --packages=external --outfile=tests/apoio/.preparar.mjs --log-level=error && node tests/apoio/.preparar.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.159.0"
  }
}
